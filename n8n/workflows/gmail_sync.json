    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const state = $('Lire curseur FastAPI').first().json;\nconst config = $('Configurer utilisateur').first().json;\nconst response = $json;\nif (response.statusCode !== 200) throw new Error(`Gmail messages.list TEST a répondu HTTP ${response.statusCode}.`);\nconst messages = Array.isArray(response.body?.messages) ? response.body.messages : [];\nif (messages.length > 50) throw new Error('Le mode TEST a reçu plus de 50 identifiants Gmail.');\nconst sync = { user_id: state.user_id, cursor_before: state.cursor || null, cursor_after: null, mode: 'test', test_mode: true, classify_in_test_mode: config.classify_in_test_mode === true };\nconst ids = [...new Set(messages.map((message) => typeof message?.id === 'string' ? message.id.trim() : '').filter(Boolean))];\nif (ids.length === 0) return [{ json: { _empty: true, _sync: sync } }];\nreturn ids.map((id) => ({ json: { gmail_message_id: id, attempt: 0, _sync: sync } }));"
