      "notesInFlow": true,
      "notes": "Lecture messages.get séquentielle. Les réponses HTTP 403/429 sont conservées pour le backoff explicite."
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const request = $('Préparer requête détail').item.json;\nconst response = $json;\nconst statusCode = Number(response.statusCode || 0);\nconst error = response.body?.error || {};\nconst reasons = Array.isArray(error.errors) ? error.errors.map((entry) => String(entry?.reason || '')) : [];\nconst errorMessage = String(error.message || '');\nconst quotaReason = reasons.some((reason) => ['rateLimitExceeded', 'userRateLimitExceeded', 'quotaExceeded'].includes(reason));\nconst quotaText = /quota|rate.?limit/i.test(errorMessage);\nconst notFound = statusCode === 404;\nconst retryable = statusCode === 429 || (statusCode === 403 && (quotaReason || quotaText));\nconst attempt = Number.isInteger(request.attempt) ? request.attempt : 0;\nconst jitter = Math.random();\nconst backoffSeconds = Math.min(32, 2 ** attempt) + jitter;\nreturn [{ json: { ...request, status_code: statusCode, not_found: notFound, retryable, retry_reasons: reasons, error_message: errorMessage, backoff_seconds: backoffSeconds, gmail_response: response.body || {} } }];"
      },
