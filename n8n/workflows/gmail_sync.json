    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const state = $('Réserver synchronisation FastAPI').first().json;\nconst ids = new Set();\nlet cursorAfter = null;\nfor (const item of $input.all()) {\n  const response = item.json;\n  if (response.statusCode !== 200) throw new Error(`Gmail history.list a répondu HTTP ${response.statusCode}. Le curseur reste inchangé.`);\n  const body = response.body || {};\n  if (typeof body.historyId === 'string' && body.historyId.trim()) cursorAfter = body.historyId.trim();\n  for (const event of Array.isArray(body.history) ? body.history : []) {\n    for (const added of Array.isArray(event.messagesAdded) ? event.messagesAdded : []) {\n      const id = typeof added?.message?.id === 'string' ? added.message.id.trim() : '';\n      if (id) ids.add(id);\n    }\n  }\n}\nif (!cursorAfter) throw new Error('Gmail history.list n’a pas fourni de historyId final.');\nconst sync = { user_id: state.user_id, execution_id: state.execution_id, idempotency_key: `gmail-sync:${$execution.id}`, cursor_before: state.cursor, cursor_after: cursorAfter, mode: 'incremental', test_mode: false };\nif (ids.size === 0) return [{ json: { _empty: true, _sync: sync } }];\nreturn [...ids].map((id) => ({ json: { gmail_message_id: id, attempt: 0, _sync: sync } }));"
      },
