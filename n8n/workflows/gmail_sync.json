        "jsCode": "const state = $('Réserver synchronisation FastAPI').first().json;\nconst profile = $('Lire profil Gmail').first().json;\nconst cursorAfter = typeof profile.historyId === 'string' ? profile.historyId.trim() : '';\nif (!cursorAfter) throw new Error('Le profil Gmail n’a pas fourni de historyId.');\nconst ids = new Set();\nfor (const item of $input.all()) {\n  if (item.json.statusCode !== 200) throw new Error(`Gmail messages.list a répondu HTTP ${item.json.statusCode}.`);\n  for (const message of Array.isArray(item.json.body?.messages) ? item.json.body.messages : []) {\n    const id = typeof message?.id === 'string' ? message.id.trim() : '';\n    if (id) ids.add(id);\n  }\n}\nconst sync = { user_id: state.user_id, execution_id: state.execution_id, idempotency_key: `gmail-sync:${$execution.id}`, cursor_before: state.cursor || null, cursor_after: cursorAfter, mode: state.cursor ? 'recovery' : 'initial', test_mode: false };\nif (ids.size === 0) return [{ json: { _empty: true, _sync: sync } }];\nreturn [...ids].map((id) => ({ json: { gmail_message_id: id, attempt: 0, _sync: sync } }));"
