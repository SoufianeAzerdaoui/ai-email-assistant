        "jsCode": "const item = $json;\nconst source = item.gmail_response || {};\nconst headers = Array.isArray(source.payload?.headers) ? source.payload.headers : [];\nconst header = (name) => {\n  const found = headers.find((entry) => String(entry?.name || '').toLowerCase() === name.toLowerCase());\n  return typeof found?.value === 'string' ? found.value.trim() : '';\n};\nconst decode = (value) => {\n  if (typeof value !== 'string' || !value) return '';\n  const normalized = value.replace(/-/g, '+').replace(/_/g, '/');\n  return Buffer.from(normalized, 'base64').toString('utf8');\n};\nconst plain = [];\nconst html = [];\nconst visit = (part) => {\n  if (!part || typeof part !== 'object') return;\n  const mime = String(part.mimeType || '').toLowerCase();\n  const filename = String(part.filename || '').trim();\n  const data = part.body?.data;\n  if (!filename && mime === 'text/plain' && data) plain.push(decode(data));\n  if (!filename && mime === 'text/html' && data) html.push(decode(data));\n  for (const child of Array.isArray(part.parts) ? part.parts : []) visit(child);\n};\nvisit(source.payload);\nconst sender = header('From');\nconst receivedAt = /^\\d+$/.test(String(source.internalDate || '')) ? new Date(Number(source.internalDate)) : new Date(header('Date'));\nif (!source.id || !source.threadId || !sender || Number.isNaN(receivedAt.getTime())) throw new Error(`Message Gmail ${item.gmail_message_id} incomplet.`);\nconst recipients = [...new Set([header('To'), header('Cc'), header('Bcc')].filter(Boolean))];\nreturn [{ json: {\n  _sync: item._sync, gmail_message_id: String(source.id), gmail_thread_id: String(source.threadId),\n  message_id: header('Message-ID') || null, sender, recipients, subject: header('Subject'),\n  body_text: plain.join('\\n\\n'), body_html: html.length ? html.join('\\n') : null, received_at: receivedAt.toISOString()\n} }];"
