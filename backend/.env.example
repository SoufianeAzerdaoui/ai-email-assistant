DATABASE_URL=postgresql+psycopg://email_assistant:change-me@localhost:5432/email_assistant
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRE_MINUTES=60
# n8n -> FastAPI : credential "Mailflow - Vers FastAPI"
WEBHOOK_SECRET=replace-with-at-least-32-random-characters
# FastAPI -> n8n : credential "Mailflow - Entrée n8n"
N8N_DRAFT_WEBHOOK_URL=http://127.0.0.1:5678/webhook/draft-generation
N8N_GMAIL_SEND_WEBHOOK_URL=http://127.0.0.1:5678/webhook/gmail-send
N8N_WEBHOOK_SECRET=replace-with-at-least-32-random-characters
N8N_REQUEST_TIMEOUT_SECONDS=10
