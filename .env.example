# PostgreSQL
POSTGRES_DB=email_assistant
POSTGRES_USER=email_assistant
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_PORT=5432

# Services applicatifs exposés uniquement sur localhost
BACKEND_PORT=8000
FRONTEND_PORT=3000

# n8n
N8N_IMAGE=docker.n8n.io/n8nio/n8n:2.43.6
N8N_PORT=5678
N8N_ENCRYPTION_KEY=replace-with-a-long-random-encryption-key
GENERIC_TIMEZONE=Europe/Paris

# Communication n8n -> FastAPI : credential "Mailflow - Vers FastAPI"
N8N_BACKEND_URL=http://backend:8000
WEBHOOK_SECRET=replace-with-the-same-secret-as-backend
MAILFLOW_USER_ID=replace-with-the-mailflow-user-uuid

# Les secrets JWT et FastAPI -> n8n restent dans backend/.env.
# Copier backend/.env.example vers backend/.env et conserver :
# - WEBHOOK_SECRET identique à la valeur ci-dessus
# - N8N_WEBHOOK_SECRET identique au credential "Mailflow - Entrée n8n"
